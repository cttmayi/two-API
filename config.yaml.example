server:
  host: "0.0.0.0"
  port: 8080

models:
  # OpenAI 官方: base_url 带上 /v1 后缀, 代理会把 /chat/completions 拼上去
  - names:
      - gpt-4o
      - gpt-4o-mini
    openai_base_url: https://api.openai.com/v1
    api_key: sk-your-openai-key

  # Anthropic 官方
  - names:
      - claude-sonnet-4-6
      - claude-opus-4-7
    anthropic_base_url: https://api.anthropic.com/v1
    api_key: sk-ant-your-anthropic-key

  # 模型别名: 客户端用 "fast" 请求, 代理转发为 "gpt-4o-mini"
  - names:
      - fast: gpt-4o-mini
    openai_base_url: https://api.openai.com/v1
    api_key: sk-your-openai-key

  # DeepSeek (OpenAI 兼容)
  - names:
      - deepseek-chat
    openai_base_url: https://api.deepseek.com/v1
    api_key: sk-your-deepseek-key
    # max_tokens 不传时不注入, 配置后客户端未传此字段时代理自动注入
    # max_tokens: 4096

  # 火山方舟 (OpenAI 兼容, 非 /v1 路径)
  - names:
      - glm-5.1
    openai_base_url: https://ark.cn-beijing.volces.com/api/v3
    api_key: ark-your-key

# 全局别名: 请求中 model 字段先查此映射, 匹配则替换后再路由
alias:
  default: gpt-4o-mini
  pro: gpt-4o

logging:
  level: INFO
  output: file
  dir: ~/.two-api/logs
